# GOTOJAIL! Web版 環境変数(キー名のみ。値はコミットしない)。
#
# ローカル開発では通常、下記いずれも設定不要(未設定でもin-memoryで動作する)。

# 外部PostgreSQL(Neon等)への接続文字列。設定すると、ルーム状態がプロセス再起動・
# 再デプロイをまたいで永続化される。未設定の場合、ルーム状態はプロセスのメモリ上にのみ
# 存在し、プロセス再起動で失われる(従来通りの挙動)。
# 例: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# durable snapshotのTTL(ミリ秒)。切断されたまま放置されたルームのsnapshotを
# 何ミリ秒後に破棄してよいかの既定値を上書きする。未設定時は24時間
# (src/server/socket/handlers.ts の DEFAULT_ROOM_SNAPSHOT_TTL_MS)。
ROOM_SNAPSHOT_TTL_MS=

# サーバーのリスンポート。未設定時は3000。Renderでは自動設定されるため通常指定不要。
PORT=
